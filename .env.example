# T.R.I.A.G.E. environment template — copy to .env and fill as needed.
# Every AI path has a deterministic local fallback; all keys are optional.

# Tier 1 bulk triage (NanoGPT aggregator, US-hosted)
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
JEV_CONCURRENCY=12

# Tier 2 deep-dive synthesis (Azure AI Foundry, eastus/eastus2)
# Trial TPM quotas: keep gated (top-1% anomalies or explicit UI click).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# NASA PSI S3 (anonymous access; no credentials required)
# AWS_* only needed if you route through your own account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1