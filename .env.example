# T.R.I.A.G.E. environment template — copy to .env and fill as needed.
# The backend auto-loads the repo-root .env on startup; shell/container
# environment variables take precedence. Every AI path has a local fallback.

# Tier 1 triage (TypeSafe Jev decision model on NanoGPT, US-hosted).
# Jev requires an account with paid/decision models enabled; a 403
# paid_features_disabled is surfaced in the fallback notes.
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://api.nano-gpt.com/api/v1
JEV_MODEL=typesafe/jev-1.14
JEV_CONCURRENCY=12

# Tier 2 deep-dive synthesis (DeepSeek v4.1 Flash on NanoGPT, US-hosted).
# Reuses NANOGPT_API_KEY. Keep gated: top-1% anomalies or explicit UI click.
TIER2_MODEL=deepseek/deepseek-v4.1-flash-1017:thinking
# The thinking model spends part of this budget on reasoning tokens; 8000
# leaves room for the ~450-word report without truncating the answer.
TIER2_MAX_TOKENS=8000
TIER2_TIMEOUT_S=180

# Optional Tier 2 fallback (Azure AI Foundry, eastus/eastus2).
# Used only when NanoGPT is unset or the DeepSeek call fails.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# NASA PSI S3 (anonymous access; no credentials required)
# AWS_* only needed if you route through your own account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1