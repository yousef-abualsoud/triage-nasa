# Frontend image: build the Vite SPA, then serve the static bundle with nginx.
# Kept separate from the backend Dockerfile so `docker compose up --build`
# works from a clean checkout (dist/ is gitignored and must not be bind-mounted).

FROM node:22-slim AS build

WORKDIR /web

COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY src/frontend/ ./
RUN npm run build

FROM nginx:alpine

COPY --from=build /web/dist/ /usr/share/nginx/html/

EXPOSE 80
